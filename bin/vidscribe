#!/bin/sh
# Dev shim: run the vidscribe package from this checkout without installing it
# (installed copies come from `uv tool install`). URLs need yt-dlp in this Python.
root="$(cd "$(dirname "$0")/.." && pwd)"
for py in python3 python; do
  "$py" -c '' 2>/dev/null && break  # skips the Windows Store python3 stub
done
PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}" exec "$py" -m vidscribe "$@"
